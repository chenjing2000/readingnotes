# Dependencies and package-manager caches
node_modules/
.npm-cache/
.pnpm-store/
.yarn/cache/

# Build output and tooling caches
/dist/
/artifacts/dist/
/coverage/
/artifacts/coverage/
.vite/
*.tsbuildinfo

# Temporary browser tests and installation checks
/test-results/
/artifacts/test-results/
/playwright-report/
/artifacts/playwright-report/
/blob-report/
/artifacts/blob-report/
/playwright/.cache/
/.install-check/
/artifacts/demo/preview-page-*.png

# Local environment and secrets; keep shareable examples
.env
.env.*
!.env.example
!.env.*.example
*.local

# Runtime logs
*.log
*.log.*

# OS and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo
*~

# Keep artifacts/demo/, artifacts/verification/, assets/ and package-lock.json tracked.

# Local shared editor preferences and isolated test settings
/config/settings.json
/config/*.tmp
/artifacts/test-runtime/
